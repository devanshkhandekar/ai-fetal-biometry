# ---------- Local platform ----------
POSTGRES_DB=fetal_biometry
POSTGRES_USER=fetal
POSTGRES_PASSWORD=fetal_local_password
DATABASE_URL=postgresql+psycopg://fetal:fetal_local_password@postgres:5432/fetal_biometry

# Object storage: MinIO locally, S3 in AWS
S3_INTERNAL_ENDPOINT=http://minio:9000
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin123
S3_REGION=us-east-1
S3_ORIGINALS_BUCKET=fetal-originals
S3_DERIVED_BUCKET=fetal-derived
S3_REPORTS_BUCKET=fetal-reports

# ElasticMQ locally, Amazon SQS in AWS
SQS_ENDPOINT=http://elasticmq:9324
SQS_REGION=us-east-1
SQS_ACCESS_KEY=x
SQS_SECRET_KEY=x
INFERENCE_QUEUE_NAME=inference-jobs
REPORT_QUEUE_NAME=report-jobs

# Local OIDC / Keycloak
AUTH_DISABLED=false
OIDC_ISSUER=http://localhost:8081/realms/fetal-local
OIDC_AUDIENCE=fetal-web
OIDC_JWKS_URL=http://keycloak:8080/realms/fetal-local/protocol/openid-connect/certs
DEFAULT_HOSPITAL_NAME=Local Demo Hospital

# API
CORS_ORIGINS=http://localhost:5173
API_BASE_URL=http://localhost:8000

# Existing model pipeline bridge.
# First use mock to validate the full app; then use python and your real module/function.
PIPELINE_MODE=mock
PIPELINE_MODULE=pipeline_devansh
PIPELINE_FUNCTION=run_inference
# Optional existing study-level deterministic aggregator (e.g. validated EFW).
STUDY_AGGREGATOR_MODULE=
STUDY_AGGREGATOR_FUNCTION=
PIPELINE_MODEL_RELEASE=local-phase0-7
MODEL_REPO_PATH=/opt/model_repo

# Optional OpenAI narrative. Leave empty to disable.
OPENAI_API_KEY=
OPENAI_MODEL=

# Frontend
VITE_API_URL=http://localhost:8000
VITE_KEYCLOAK_URL=http://localhost:8081
VITE_KEYCLOAK_REALM=fetal-local
VITE_KEYCLOAK_CLIENT_ID=fetal-web
