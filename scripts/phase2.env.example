# Copy to scripts/phase2.env and replace every /ABSOLUTE/... value.

# The Python executable from the environment that already runs your unified pipeline.
PIPELINE_PYTHON=/ABSOLUTE/PATH/TO/miniconda3/envs/fetal_biometry_unified/bin/python

# This file is inside the new full-stack project.
PIPELINE_BRIDGE_SCRIPT=/ABSOLUTE/PATH/TO/fetal-biometry-local/ml/bridge_cli.py

# Root of the existing, already-working fetal-biometry ML repository.
MODEL_REPO_PATH=/ABSOLUTE/PATH/TO/your/current/fetal-biometry-mvp

# Prefer your latest already-working integrated scan callable if one exists.
# It should run the existing plane -> quality -> routing -> HEAD/ABDOMEN/FEMUR pipeline.
# The adapter accepts common argument names such as image_path/input_path, anatomy,
# pixel_spacing(_mm), roi and output_dir/workdir.
REAL_SCAN_MODULE=
REAL_SCAN_FUNCTION=

# If REAL_SCAN_MODULE/FUNCTION are left blank, HEAD can use the exact function
# already used by your current Streamlit app: src.pipeline_devansh.run_case_devansh.
HEAD_CHECKPOINT_PATH=/ABSOLUTE/PATH/TO/models/checkpoints/4a_best_pruned_ft_v10.pth
HEAD_MODEL_VARIANT=phase4a
HEAD_THRESHOLD=0.50

# Preserve the existing HRNet subprocess setup. Your integrated pipeline may read
# this environment variable; adjust the variable name only if your existing code uses another one.
HRNET_PYTHON=/ABSOLUTE/PATH/TO/miniconda3/envs/fetalbiometry_hrnet/bin/python

# Phase 3: point to YOUR validated HC + AC + FL -> EFW function.
# No Hadlock variant is invented in the platform code.
REAL_EFW_MODULE=
REAL_EFW_FUNCTION=
EFW_FORMULA_VERSION=

# Provenance label stored in every saved inference result.
PIPELINE_MODEL_RELEASE=phase0-7-real-local-v1

# Subprocess timeout per scan. Increase only if your known pipeline legitimately needs longer.
PIPELINE_TIMEOUT_SEC=300

# Leave false throughout Phase 2. Turn true only in Phase 3 after the real EFW callable is configured.
ENABLE_STUDY_AGGREGATION=false
