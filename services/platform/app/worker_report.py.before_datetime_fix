from __future__ import annotations

import base64
import json
import mimetypes
import tempfile
import traceback
from datetime import datetime, timezone
from pathlib import Path

from jinja2 import Environment, FileSystemLoader, select_autoescape
from sqlalchemy import select
from weasyprint import HTML

from app.config import settings
from app.db import SessionLocal
from app.models import InferenceRun, Report, ScanObject, Study
from app.queueing import receive
from app.services import build_study_report_json
from app.storage import download_file, upload_file
from app.json_safe import json_safe
TEMPLATE_DIR = Path(__file__).resolve().parent.parent / "templates"
env = Environment(loader=FileSystemLoader(TEMPLATE_DIR), autoescape=select_autoescape(["html", "xml"]))


def _as_data_uri(bucket: str, key: str, content_type: str | None, workdir: Path, name: str) -> str | None:
    try:
        suffix = Path(key).suffix or ".bin"
        path = workdir / f"{name}{suffix}"
        download_file(bucket, key, str(path))
        mime = content_type or mimetypes.guess_type(str(path))[0] or "application/octet-stream"
        if not mime.startswith("image/"):
            return None
        encoded = base64.b64encode(path.read_bytes()).decode("ascii")
        return f"data:{mime};base64,{encoded}"
    except Exception:
        return None


def _attach_report_images(db, study: Study, data: dict, workdir: Path) -> None:
    for scan_data in data.get("scans", []):
        scan = db.get(ScanObject, scan_data.get("id"))
        if scan is None:
            continue
        images: dict[str, str] = {}
        original = _as_data_uri(
            settings.s3_originals_bucket,
            scan.object_key,
            scan.content_type,
            workdir,
            f"{scan.id}-original",
        )
        if original:
            images["original"] = original

        run = db.scalar(
            select(InferenceRun)
            .where(InferenceRun.scan_id == scan.id)
            .order_by(InferenceRun.created_at.desc())
        )
        result = (run.result_json or {}) if run else {}
        for name in ("overlay", "mask", "preview"):
            info = (result.get("artifacts") or {}).get(name)
            if not isinstance(info, dict) or not info.get("object_key"):
                continue
            uri = _as_data_uri(
                settings.s3_derived_bucket,
                info["object_key"],
                info.get("content_type"),
                workdir,
                f"{scan.id}-{name}",
            )
            if uri:
                images[name] = uri
        scan_data["report_images"] = images


def process_report(report_id: str):
    db = SessionLocal()
    try:
        report = db.get(Report, report_id)
        if not report or report.status == "COMPLETE":
            return
        study = db.get(Study, report.study_id)
        report.status = "RUNNING"
        db.commit()

        data = build_study_report_json(db, study)
        with tempfile.TemporaryDirectory(prefix="fetal-report-") as td:
            td_path = Path(td)
            _attach_report_images(db, study, data, td_path)
            report.report_json = data
            html = env.get_template("report.html").render(report=report, data=data)
            pdf_path = td_path / "report.pdf"
            HTML(string=html).write_pdf(pdf_path)
            key = f"{study.hospital_id}/{study.id}/{report.id}/{report.report_type.lower()}-{report.language}.pdf"
            upload_file(settings.s3_reports_bucket, key, str(pdf_path), "application/pdf")

        report.object_key = key
        report.status = "COMPLETE"
        report.completed_at = datetime.now(timezone.utc)
        db.commit()
    except Exception as exc:
        db.rollback()
        report = db.get(Report, report_id)
        if report:
            report.status = "FAILED"
            report.error = f"{type(exc).__name__}: {exc}"
            db.commit()
        traceback.print_exc()
    finally:
        db.close()


def main():
    print("Report worker started")
    while True:
        client, url, messages = receive(settings.report_queue_name)
        for msg in messages:
            body = json.loads(msg["Body"])
            process_report(body["report_id"])
            client.delete_message(QueueUrl=url, ReceiptHandle=msg["ReceiptHandle"])


if __name__ == "__main__":
    main()
