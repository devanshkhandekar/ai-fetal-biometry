# Optional GPU image. Adjust CUDA/Python base only if your validated model
# environment requires a different CUDA stack. Host-worker mode avoids this
# migration risk during the first local full-stack milestone.
FROM nvidia/cuda:12.1.1-cudnn8-runtime-ubuntu22.04
ENV DEBIAN_FRONTEND=noninteractive PYTHONUNBUFFERED=1
RUN apt-get update && apt-get install -y --no-install-recommends     python3 python3-pip python3-venv gcc libpq-dev libgl1 libglib2.0-0     && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY requirements.txt requirements-ml.txt ./
RUN python3 -m pip install --no-cache-dir -r requirements.txt &&     python3 -m pip install --no-cache-dir -r requirements-ml.txt
COPY . .
CMD ["python3", "-m", "app.worker_inference"]
